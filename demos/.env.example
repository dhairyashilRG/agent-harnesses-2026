# OpenRouter powers most demos (one key, ~400 models).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Optional: any OpenRouter model id
# OPENROUTER_MODEL=meta/muse-spark-1.3

# Copy to .env and fill in. Never commit the real .env.
#   cp demos/.env.example demos/.env

# Anthropic demos (01_foundations, 02_core_loop, 05_advanced/orchestrator, 08_future)

# DeepSeek demos (04_building/duck_harness_simplified, 05_advanced/self_improving_harness)
DEEPSEEK_API_KEY=

# Optional model overrides (see demos/_config.py for defaults). Update on recording day.

# DEEPSEEK_MODEL=deepseek-flash
# OPENAI_MODEL=gpt-5
